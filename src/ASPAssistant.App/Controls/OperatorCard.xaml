<UserControl x:Class="ASPAssistant.App.Controls.OperatorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <UserControl.Resources>
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <converters:LocalPathToImageConverter x:Key="LocalImage" />
        <DataTemplate x:Key="CovenantChip">
            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">
                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="VariantDetails">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8"
                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                    BorderThickness="1" Padding="12" Width="228" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,10,0"
                                Background="{DynamicResource NeutralHoverBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Stretch="UniformToFill"
                                   Source="{Binding DataContext.IconPath, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource LocalImage}}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding DataContext.Tier, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource TierToRoman}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                           FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <ItemsControl ItemsSource="{Binding DataContext.CoreCovenants, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                      ItemTemplate="{StaticResource CovenantChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding DataContext.AdditionalCovenants, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                      ItemTemplate="{StaticResource CovenantChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Traits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding TraitType}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TraitDescription}" FontSize="12" LineHeight="19"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Border x:Name="CardBorder" BorderThickness="1" CornerRadius="3" Margin="0,0,0,2"
            ToolTipService.InitialShowDelay="0"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.ShowDuration="60000">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ToolTip>
            <ToolTip x:Name="DetailsToolTip" Placement="Left" HorizontalOffset="-8"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False"
                     MaxHeight="700">
                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="10" Padding="6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Normal}" Tag="普通"
                                            Foreground="{DynamicResource AccentBrush}"
                                            ContentTemplate="{StaticResource VariantDetails}" VerticalAlignment="Top" />
                            <ContentControl Content="{Binding Elite}" Tag="精锐" Margin="8,0,0,0"
                                            Foreground="{DynamicResource EliteBrush}"
                                            ContentTemplate="{StaticResource VariantDetails}" VerticalAlignment="Top" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </ToolTip>
        </Border.ToolTip>
        <Grid Height="38" ClipToBounds="True">
            <Image x:Name="PortraitBackground" Width="134" HorizontalAlignment="Right" Stretch="UniformToFill" Opacity="0.8"
                   Source="{Binding IconPath, Converter={StaticResource LocalImage}}" />
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource RowGradientStartColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource RowGradientMiddleColor}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource RowGradientEndColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="BanDimOverlay" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
            <Grid Margin="8,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TrackingPortrait" Width="28" Height="28" Margin="0,0,7,0"
                        CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center"
                        Background="{DynamicResource NeutralHoverBrush}" Visibility="Collapsed">
                    <Image Source="{Binding IconPath, Converter={StaticResource LocalImage}}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Grid.Column="2" Background="{DynamicResource SummaryBackgroundBrush}" CornerRadius="3" Padding="3,2"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CovenantSummary" FontSize="10" TextAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="BanBadge" Grid.Column="3" Background="#BBDD2222" CornerRadius="3"
                        Padding="4,1" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="禁用" FontSize="9" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TrackButton" Width="25" Height="25" Padding="0" FontSize="14"
                            Style="{StaticResource TrackingButton}" Click="OnTrackClick" />
                    <Button x:Name="BanButton" Width="25" Height="25" Padding="0" FontSize="12" Margin="4,0,0,0"
                            Style="{StaticResource BanToggleButton}" Click="OnBanClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
